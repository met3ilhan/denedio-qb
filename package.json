{
  "name": "question-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && node scripts/run-playwright.mjs test",
    "test:e2e:live": "pnpm build && node scripts/run-playwright-live.mjs",
    "test:e2e:live:downstream": "pnpm build && node scripts/run-playwright-live-downstream.mjs",
    "test:live-gemini-smoke": "pnpm test:e2e:live",
    "db:up": "docker compose up -d question-studio-db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/with-local-env.mjs pnpm exec prisma migrate dev",
    "db:generate": "node scripts/with-local-env.mjs pnpm exec prisma generate",
    "db:studio": "node scripts/with-local-env.mjs pnpm exec prisma studio",
    "db:deploy": "node scripts/with-local-env.mjs pnpm exec prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/env": "15.5.25",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
