// Question Studio database — isolated from Denedio. See docker-compose.yml.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// UX workflow phases (Intake · Mechanism · Candidates · Ship).
enum MissionPhase {
  INTAKE
  MECHANISM
  CANDIDATES
  SHIP
}

enum ExtractionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SourceExtractionReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FingerprintPipelineState {
  NOT_STARTED
  DRAFT
  LOCKED
}

/// Stub user for ownership and provenance actor references (auth later).
model User {
  id               String             @id @default(cuid())
  email            String?            @unique
  displayName      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ownedMissions    Mission[]          @relation("MissionOwner")
  provenanceEvents ProvenanceEvent[]
}

model Mission {
  id           String             @id @default(cuid())
  title        String
  phase        MissionPhase         @default(INTAKE)
  ownerId      String?
  owner        User?                @relation("MissionOwner", fields: [ownerId], references: [id])
  /// Opaque artifact pointers (source ids, fingerprint version ids, etc.)
  artifactRefs Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  events       ProvenanceEvent[]
  sourceFiles  SourceFile[]

  @@index([phase])
  @@index([ownerId])
}

/// Append-only audit trail for mission thread (no updatedAt).
model ProvenanceEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
}

model SourceFile {
  id               String                   @id @default(cuid())
  missionId        String
  mission          Mission                  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String                   @unique
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  subjectHint      String?
  languageHint     String?
  notes            String?
  fingerprintState FingerprintPipelineState @default(NOT_STARTED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  extractionJobs   ExtractionJob[]
  sourceQuestions  SourceQuestion[]

  @@index([missionId])
  @@index([createdAt])
}

model ExtractionJob {
  id           String              @id @default(cuid())
  sourceFileId String
  sourceFile   SourceFile          @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  status       ExtractionJobStatus @default(PENDING)
  attempt      Int                 @default(1)
  priority     Int                 @default(0)
  /// Expert-readable log lines: { at, level, message }
  logs         Json                @default("[]")
  /// Parsed SourceExtractionSchema JSON
  result       Json?
  /// Analyst envelope: block layers, provider metadata
  analystMeta  Json?
  errorCode    String?
  errorMessage String?
  providerId   String?
  modelId      String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  sourceQuestions SourceQuestion[]

  @@index([sourceFileId, createdAt])
  @@index([status])
}

model SourceQuestion {
  id              String                       @id @default(cuid())
  sourceFileId    String
  sourceFile      SourceFile                   @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  extractionJobId String
  extractionJob   ExtractionJob                @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)
  structured      Json
  reviewStatus    SourceExtractionReviewStatus @default(PENDING)
  defectTags      String[]                     @default([])
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([sourceFileId])
}
