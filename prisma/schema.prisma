// Question Studio database — isolated from Denedio. See docker-compose.yml.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// UX workflow phases (Intake · Mechanism · Candidates · Ship).
enum MissionPhase {
  INTAKE
  MECHANISM
  CANDIDATES
  SHIP
}

enum ExtractionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SourceExtractionReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FingerprintPipelineState {
  NOT_STARTED
  DRAFT
  LOCKED
}

enum FingerprintVersionStatus {
  DRAFT
  LOCKED
}

enum GenerationRunStatus {
  SETUP
  READY
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CandidatePipelineStatus {
  DRAFT
  DISTRACTOR_COMPLETE
  SOLVED
  VERIFIED
  APPROVED
  REJECTED
}

enum GeneratedQuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

/// Stub user for ownership and provenance actor references (auth later).
model User {
  id               String             @id @default(cuid())
  email            String?            @unique
  displayName      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ownedMissions    Mission[]          @relation("MissionOwner")
  provenanceEvents ProvenanceEvent[]
}

model Mission {
  id           String             @id @default(cuid())
  title        String
  phase        MissionPhase         @default(INTAKE)
  ownerId      String?
  owner        User?                @relation("MissionOwner", fields: [ownerId], references: [id])
  /// Opaque artifact pointers (source ids, fingerprint version ids, etc.)
  artifactRefs Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  events       ProvenanceEvent[]
  sourceFiles  SourceFile[]
  generationRuns GenerationRun[]

  @@index([phase])
  @@index([ownerId])
}

/// Append-only audit trail for mission thread (no updatedAt).
model ProvenanceEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
}

model SourceFile {
  id               String                   @id @default(cuid())
  missionId        String
  mission          Mission                  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String                   @unique
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  subjectHint      String?
  languageHint     String?
  notes            String?
  fingerprintState FingerprintPipelineState @default(NOT_STARTED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  extractionJobs   ExtractionJob[]
  sourceQuestions  SourceQuestion[]

  @@index([missionId])
  @@index([createdAt])
}

model ExtractionJob {
  id           String              @id @default(cuid())
  sourceFileId String
  sourceFile   SourceFile          @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  status       ExtractionJobStatus @default(PENDING)
  attempt      Int                 @default(1)
  priority     Int                 @default(0)
  /// Expert-readable log lines: { at, level, message }
  logs         Json                @default("[]")
  /// Parsed SourceExtractionSchema JSON
  result       Json?
  /// Analyst envelope: block layers, provider metadata
  analystMeta  Json?
  errorCode    String?
  errorMessage String?
  providerId   String?
  modelId      String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  sourceQuestions SourceQuestion[]

  @@index([sourceFileId, createdAt])
  @@index([status])
}

model SourceQuestion {
  id              String                       @id @default(cuid())
  sourceFileId    String
  sourceFile      SourceFile                   @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  extractionJobId String
  extractionJob   ExtractionJob                @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)
  structured      Json
  reviewStatus    SourceExtractionReviewStatus @default(PENDING)
  defectTags      String[]                     @default([])
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  pedagogicalFingerprint PedagogicalFingerprint?

  @@index([sourceFileId])
}

model PedagogicalFingerprint {
  id               String           @id @default(cuid())
  sourceQuestionId String           @unique
  sourceQuestion   SourceQuestion   @relation(fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  versions         PedagogicalFingerprintVersion[]
}

model PedagogicalFingerprintVersion {
  id              String                   @id @default(cuid())
  fingerprintId   String
  fingerprint     PedagogicalFingerprint   @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  versionNumber   Int
  status          FingerprintVersionStatus @default(DRAFT)
  payload         Json
  lockedAt        DateTime?
  lockedById      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  evidence        FingerprintEvidence[]
  generationRuns  GenerationRun[]
  mutationPlans   MutationPlan[]

  @@unique([fingerprintId, versionNumber])
  @@index([status])
}

model FingerprintEvidence {
  id           String                        @id @default(cuid())
  versionId    String
  version      PedagogicalFingerprintVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dimensionKey String
  evidenceType String
  pointer      Json
  excerpt      String
  createdAt    DateTime                      @default(now())

  @@index([versionId])
}

model GenerationRun {
  id                   String                        @id @default(cuid())
  missionId            String
  mission              Mission                       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  fingerprintVersionId String
  fingerprintVersion   PedagogicalFingerprintVersion @relation(fields: [fingerprintVersionId], references: [id])
  status               GenerationRunStatus           @default(SETUP)
  providerId           String?
  modelId              String?
  stageLog             Json                          @default("[]")
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  mutationPlans        MutationPlan[]
  candidates           GeneratedQuestionCandidate[]

  @@index([missionId])
}

model MutationPlan {
  id                   String                        @id @default(cuid())
  generationRunId      String
  generationRun        GenerationRun                 @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  fingerprintVersionId String
  fingerprintVersion   PedagogicalFingerprintVersion @relation(fields: [fingerprintVersionId], references: [id])
  payload              Json
  siblingIndex         Int                           @default(0)
  createdAt            DateTime                      @default(now())
  candidates           GeneratedQuestionCandidate[]

  @@index([generationRunId])
}

model GeneratedQuestionCandidate {
  id                   String                  @id @default(cuid())
  generationRunId      String
  generationRun        GenerationRun           @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  mutationPlanId       String
  mutationPlan         MutationPlan            @relation(fields: [mutationPlanId], references: [id])
  siblingIndex         Int                     @default(0)
  status               CandidatePipelineStatus @default(DRAFT)
  draft                Json
  distractorAnalysis   Json?
  verificationStaleAt  DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  solverRuns           SolverRun[]
  verifierRuns         VerifierRun[]
  approvalRecords      ApprovalRecord[]
  generatedQuestion    GeneratedQuestion?

  @@index([generationRunId])
  @@index([status])
}

model SolverRun {
  id                           String                   @id @default(cuid())
  candidateId                  String
  candidate                    GeneratedQuestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  independentOfGenerationRunId String
  providerId                   String
  modelId                      String
  result                       Json
  createdAt                    DateTime                 @default(now())

  @@index([candidateId, createdAt])
}

model VerifierRun {
  id          String                   @id @default(cuid())
  candidateId String
  candidate   GeneratedQuestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  result      Json
  stale       Boolean                  @default(false)
  createdAt   DateTime                 @default(now())

  @@index([candidateId, createdAt])
}

model ApprovalRecord {
  id          String                   @id @default(cuid())
  candidateId String
  candidate   GeneratedQuestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checklist   Json
  comment     String?
  decision    String
  actorLabel  String                   @default("expert")
  createdAt   DateTime                 @default(now())

  @@index([candidateId])
}

model GeneratedQuestion {
  id                   String                  @id @default(cuid())
  candidateId          String                  @unique
  candidate            GeneratedQuestionCandidate @relation(fields: [candidateId], references: [id])
  sourceQuestionId     String
  fingerprintVersionId String
  status               GeneratedQuestionStatus @default(APPROVED)
  importExternalKey    String                  @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  versions             QuestionVersion[]
  denedioMapping       DenedioFieldMapping?
  exportAttempts       ExportAttempt[]

  @@index([status])
}

model QuestionVersion {
  id                  String            @id @default(cuid())
  generatedQuestionId String
  generatedQuestion   GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)
  versionNumber       Int
  content             Json
  createdByLabel      String            @default("expert")
  parentVersionId     String?
  revisionReason      String?
  /// VERIFIED | NEEDS_REVERIFY — export requires latest VERIFIED
  verificationState   String            @default("VERIFIED")
  /// APPROVED | DRAFT
  approvalState       String            @default("APPROVED")
  createdAt           DateTime          @default(now())

  @@unique([generatedQuestionId, versionNumber])
}

/// S17 curriculum + trap UUID selections (Denedio import mapping).
model DenedioFieldMapping {
  id                  String            @id @default(cuid())
  generatedQuestionId String            @unique
  generatedQuestion   GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)
  examTypeId          String
  examSectionId       String
  subjectId           String
  topicId             String
  unitId              String?
  outcomeId           String?
  questionArchetypeId String?
  /// Studio trap slug → Denedio trapType UUID overrides
  trapTypeMap         Json              @default("{}")
  /// Cached QuestionImportPayload (schemaVersion + items)
  payloadCache        Json?
  updatedAt           DateTime          @updatedAt
  createdAt           DateTime          @default(now())
}

/// S18 dry-run audit record.
model ExportAttempt {
  id                  String            @id @default(cuid())
  generatedQuestionId String
  generatedQuestion   GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)
  passed              Boolean
  dryRunResult        Json
  payloadHash         String
  createdAt           DateTime          @default(now())

  @@index([generatedQuestionId, createdAt])
}
