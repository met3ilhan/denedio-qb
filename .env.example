# Question Studio — copy to .env.local for local development (never commit secrets).

# AI provider key for Studio pipelines (Implementer gates; not used in P01 scaffold)
STUDIO_AI_API_KEY=

# Public app URL (optional; defaults work for local dev)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (future — Prisma added in a later gate; use Docker locally when introduced)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/question_studio
