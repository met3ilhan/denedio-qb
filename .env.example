# Question Studio — copy to .env.local for local development (never commit secrets).

# AI provider key for Studio pipelines (Implementer gates; not used in P01 scaffold)
STUDIO_AI_API_KEY=

# Execution mode: LIVE | DEMO | MOCK | MANUAL (recommended local: MOCK)
# Legacy QUESTION_STUDIO_DEMO_MODE=1 now maps to MOCK, not silent kayak fixtures.
QUESTION_STUDIO_PROVIDER_MODE=MOCK
QUESTION_STUDIO_DEMO_MODE=1

# Optional Gemini source analyst (LIVE mode only; fails visibly if missing)
QUESTION_STUDIO_GEMINI_API_KEY=
# Optional override (default source analyst: gemini-2.5-flash)
# QUESTION_STUDIO_GEMINI_MODEL=

# Local upload storage root (default: .data/uploads)
# QUESTION_STUDIO_STORAGE_ROOT=

# Public app URL (optional; defaults work for local dev)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Question Studio PostgreSQL (docker-compose.yml — NOT Denedio)
DATABASE_URL=postgresql://question_studio:question_studio@localhost:5433/question_studio
